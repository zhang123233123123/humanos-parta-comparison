DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
DEEPSEEK_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
HUMANOS_BACKEND_URL=http://localhost:8787

# Browser-only frontend preview. Leave disabled for normal operation.
# npm run dev:demo sets both flags in its child process on port 3100.
HUMANOS_DEMO_MODE=0
NEXT_PUBLIC_HUMANOS_DEMO_MODE=0

# Enable only against an isolated simulation backend, with the same proxy secret.
HUMANOS_SIMULATION_MODE=0
HUMANOS_SIMULATION_PROXY_SECRET=

# Internal Part A workbench; browser calls signed same-origin proxies only.
HUMANOS_PARTA_MODE=0
HUMANOS_PARTA_PROXY_SECRET=

# Part A 专属链接的工具主体，不是产品用户账号；前后端保持一致
HUMANOS_PARTA_LINK_ACTOR=
# 随机访问令牌的 SHA-256；不在源码保存令牌原文
HUMANOS_PARTA_LINK_HASH=
