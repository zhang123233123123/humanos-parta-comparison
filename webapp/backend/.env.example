DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://llmapi.fiblab.net/v1
DEEPSEEK_TIMEOUT_SECONDS=90
# Both JSON completion and intent routing explicitly send thinking.type=disabled.
# This policy is set in code, independently of the gateway's default mode.
# Per-process concurrent full weekly scheduling workflows (1–32, default 4).
# Same-user generations remain serialized. This is not a global LLM API limit:
# daily reviews, session proposals and other model calls have separate paths.
# Keep the canonical backend a single process; locks are process-local.
HUMANOS_SCHEDULE_MAX_CONCURRENCY=4
# For slower gateways, use a bounded timeout such as 90 seconds.
# OpenAI-compatible gateway example: https://llmapi.fiblab.net/v1
# Set DEEPSEEK_MODEL to an available model, e.g. deepseek-v4-flash.

# Embeddings use their own credential; legacy DASHSCOPE_API_KEY remains supported.
AI_EMBEDDING_API_KEY=replace_with_your_embedding_key
AI_EMBEDDING_BASE_URL=https://llmapi.fiblab.net/v1
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_TIMEOUT_SECONDS=60
# Shared cosine threshold for behavior grouping and recent single-event retrieval.
# Eligible long-term patterns are injected directly, without a similarity filter.
# Three independent occurrences trigger automatic learning; at most three patterns are injected.
BEHAVIOR_SIMILARITY_THRESHOLD=0.55

# Isolated scenario simulation. Export these BEFORE starting the backend.
# Keep disabled for ordinary HumanOS. Never point at a production/backup database.
HUMANOS_SIMULATION_MODE=0
# HUMANOS_DB_PATH=/absolute/path/to/new-simulation.sqlite3
# Same random secret on backend and Next.js; at least 32 characters.
HUMANOS_SIMULATION_PROXY_SECRET=
# Comma-separated existing user IDs registered in this simulation instance.
HUMANOS_SIMULATION_RESEARCHERS=

# Internal Part A comparison workbench. Keep disabled on participant instances.
HUMANOS_PARTA_MODE=0
# Same random >=32-character value on Next.js and backend; never NEXT_PUBLIC.
HUMANOS_PARTA_PROXY_SECRET=
# Comma-separated existing authenticated user IDs allowed to read historical materials.
HUMANOS_PARTA_RESEARCHERS=
# Defaults to repository-root/PartA预实验. Set absolute path for a relocated installation.
# HUMANOS_PARTA_MATERIALS=/absolute/path/to/PartA预实验
# Runs are kept separately in backend/data/parta-pretest.sqlite3.

# Part A 专属链接的工具主体，不是产品用户账号；前后端保持一致
HUMANOS_PARTA_LINK_ACTOR=
